  "issues": {
    "deprecated_quiet_switch": {
      "title": "{entity_id} is verouderd",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "{entity_id} uitschakelen?",
            "description": "{entity_id} wordt in een volgende versie verwijderd. Stil is nu een ventilatormodus van de klimaatentiteit. Gebruik die (of het veld fan_mode van ewpe_smart.set_state) in je automatiseringen en dashboards.\n\n{entity_id} nu uitschakelen? Tot de entiteit verwijderd wordt, kun je ze weer inschakelen in de entiteitsinstellingen."
          }
        }
      }
    },
    "deprecated_turbo_switch": {
      "title": "{entity_id} is verouderd",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "{entity_id} uitschakelen?",
            "description": "{entity_id} wordt in een volgende versie verwijderd. Turbo is nu een ventilatormodus van de klimaatentiteit. Gebruik die (of het veld fan_mode van ewpe_smart.set_state) in je automatiseringen en dashboards.\n\n{entity_id} nu uitschakelen? Tot de entiteit verwijderd wordt, kun je ze weer inschakelen in de entiteitsinstellingen."
          }
        }
      }
    }

  "issues": {
    "deprecated_quiet_switch": {
      "title": "{entity_id} está obsoleto",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "¿Deshabilitar {entity_id}?",
            "description": "{entity_id} se eliminará en una versión futura. Silencioso es ahora un modo de ventilador de la entidad de climatización. Úsalo (o el campo fan_mode de ewpe_smart.set_state) en tus automatizaciones y paneles.\n\n¿Deshabilitar {entity_id} ahora? Puedes volver a habilitarlo en la configuración de la entidad hasta que se elimine."
          }
        }
      }
    },
    "deprecated_turbo_switch": {
      "title": "{entity_id} está obsoleto",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "¿Deshabilitar {entity_id}?",
            "description": "{entity_id} se eliminará en una versión futura. Turbo es ahora un modo de ventilador de la entidad de climatización. Úsalo (o el campo fan_mode de ewpe_smart.set_state) en tus automatizaciones y paneles.\n\n¿Deshabilitar {entity_id} ahora? Puedes volver a habilitarlo en la configuración de la entidad hasta que se elimine."
          }
        }
      }
    }
